<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title | default: "M. — Creative Studio & Editorial Portfolio" }}</title>
  <meta name="description" content="{{ page_description | default: 'Specializing in architectural minimalism and high-end editorial digital experiences for luxury brands.' }}">
  
  <!-- Compiled SCSS Styles -->
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  
  <!-- Lit Web Components Bundle -->
  <script type="module" src="{{ 'app.js' | asset_url }}"></script>
</head>
<body>

  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

</body>
</html>
